generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}




model User {
  id                      String         @id @default(auto()) @map("_id") @db.ObjectId
  name                    String
  email                   String         @unique
  phone                   String
  password                String
  role                    userStatus
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  @@map("users")
}



model ServicePlan {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  pacakagesName      String
  timeApprox         String
  cost               Float
  duration           Int
  coverage           String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt 
  SimpleReport       SimpleReport[]    

  @@map("ServicesPlan")
}


model Booking {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String
  phoneNumber String
  service     String
  day         String
  hours       Int
  min         Int
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("bookings")
}

model ContactUs {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String
  message       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("contactus")
}

enum userStatus{
  ADMIN
}
enum ScanType {
  BLOOD_TEST
  URINE_TEST
  X_RAY
  MRI
  CT_SCAN
}

enum Status {
  PENDING
  COMPLETED
  CANCELLED
}

model SimpleReport {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId

  servicePlanId String   @db.ObjectId
  servicePlan   ServicePlan @relation(fields: [servicePlanId], references: [id])

  userId        String   @db.ObjectId
  
  scanType      ScanType
  appointmentDate DateTime
  status        Status
  notes         String
  message       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("simplereport")
}

model Testimonial {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String
  message       String
  image         String?
  facebookURL   String?
  linkLindeURL  String?
  instragramURL String? 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("testimonials")
}