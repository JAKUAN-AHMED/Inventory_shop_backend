generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum LicenseType {
  AIRPLANE
  HELICOPTER
  GAS_BALLOON
  HOT_AIR_BALLOON
  GLIDER
  RADIO_CERTIFICATE
  SAILPLANE
}

enum TestStatus {
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

enum PaymentStatus {
  PAID
  UNPAID
  CANCELLED
}

model User {
  id                      String              @id @default(auto()) @map("_id") @db.ObjectId
  name                    String              @unique
  email                   String              @unique
  password                String
  phone                   String
  role                    UserRole            @default(STUDENT)
  isVerified              Boolean             @default(false)
  verificationToken       String?             @unique
  verificationTokenExpiry DateTime?
  profileImage            String?             @default("https://ibb.co/q36v3f9w")
  joinDate                DateTime            @default(now())
  lastLogin               DateTime?
  payment                 Payment[]
  testResults             TestResult[]
  rating                  ExplanationRating[]
  bookmarks               Bookmark[]
  comments                Comment[]
  explanations            Explanation[]
  downVotes               DownVote[]
  upVotes                 UpVotes[]
  replies                 Reply[]
  tests                   Test[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@map("users")
}

model License {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String         @unique
  type          LicenseType?
  description   String?
  price         Float?
  // productId     String?
  payments      Payment[]
  tests         Test[]
  licenseTopics LicenseTopic[]

  @@map("licenses")
}

model LicenseTopic {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  licenseId String  @db.ObjectId
  license   License @relation(fields: [licenseId], references: [id])
  topicId   String? @db.ObjectId
  topic     Topic?  @relation(fields: [topicId], references: [id])

  @@map("licenses_topics")
}

model Topic {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String?
  licenseTopics LicenseTopic[]
  questions     Question[]
  tests         Test[]
  testResults   TestResult[]

  @@map("topics")
}

model Question {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  topic         Topic          @relation(fields: [topicId], references: [id])
  topicId       String         @db.ObjectId
  text          String @unique
  explanation   Explanation[]
  difficulty    Int            @default(1)
  answers       Answer[]
  bookmarks     Bookmark[]
  comments      Comment[]
  testQuestions TestQuestion[]

  @@map("questions")
}

model Explanation {
  id         String              @id @default(auto()) @map("_id") @db.ObjectId
  question   Question            @relation(fields: [questionId], references: [id])
  questionId String              @db.ObjectId
  user       User                @relation(fields: [userId], references: [id])
  userId     String              @db.ObjectId
  text       String
  rating     ExplanationRating[]
}

model ExplanationRating {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  explanation   Explanation @relation(fields: [explanationId], references: [id])
  explanationId String      @db.ObjectId
  user          User        @relation(fields: [userId], references: [id])
  userId        String      @db.ObjectId
  rating        Int

  @@map("explanationRatings")
}

model Answer {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  question      Question       @relation(fields: [questionId], references: [id])
  questionId    String         @db.ObjectId
  text          String         @unique
  isCorrect     Boolean        @default(false)
  testQuestions TestQuestion[]

  @@map("answers")
}

model Test {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  user        User           @relation(fields: [userId], references: [id])
  userId      String         @db.ObjectId
  license     License        @relation(fields: [licenseId], references: [id])
  licenseId   String         @db.ObjectId
  topic       Topic          @relation(fields: [topicId], references: [id])
  topicId     String         @db.ObjectId
  date        DateTime       @default(now())
  score       Float?
  total       Int
  status      TestStatus     @default(IN_PROGRESS)
  questions   TestQuestion[]
  bookmarks   Bookmark[]
  testResults TestResult[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("tests")
}

model TestQuestion {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  test       Test     @relation(fields: [testId], references: [id])
  testId     String   @db.ObjectId
  question   Question @relation(fields: [questionId], references: [id])
  questionId String   @db.ObjectId
  selected   Int?
  isCorrect  Boolean?
  answer     Answer?  @relation(fields: [answerId], references: [id])
  answerId   String?  @db.ObjectId

  @@unique([testId, questionId])
  @@map("testQuestions")
}

model TestResult {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  test      Test     @relation(fields: [testId], references: [id])
  testId    String   @db.ObjectId
  topic     Topic    @relation(fields: [topicId], references: [id])
  topicId   String   @db.ObjectId
  date      DateTime @default(now())
  score     Float?   @default(0)
  createdAt DateTime @default(now())

  @@map("testResults")
}

model Bookmark {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  userId     String   @db.ObjectId
  question   Question @relation(fields: [questionId], references: [id])
  questionId String   @db.ObjectId
  test       Test?    @relation(fields: [testId], references: [id])
  testId     String?  @db.ObjectId
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@map("bookmarks")
}

model Comment {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  user       User       @relation(fields: [userId], references: [id])
  userId     String     @db.ObjectId
  question   Question   @relation(fields: [questionId], references: [id])
  questionId String     @db.ObjectId
  text       String
  downVote   DownVote[]
  upVote     UpVotes[]
  createdAt  DateTime   @default(now())
  replies    Reply[]

  @@map("comments")
}

model DownVote {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  user      User    @relation(fields: [userId], references: [id])
  userId    String  @db.ObjectId
  comment   Comment @relation(fields: [commentId], references: [id])
  commentId String  @db.ObjectId
  vote      Int

  @@map("downVotes")
}

model UpVotes {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  user      User    @relation(fields: [userId], references: [id])
  userId    String  @db.ObjectId
  comment   Comment @relation(fields: [commentId], references: [id])
  commentId String  @db.ObjectId
  vote      Int

  @@map("upVotes")
}

model Reply {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  comment   Comment  @relation(fields: [commentId], references: [id])
  commentId String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  text      String
  createdAt DateTime @default(now())

  @@map("replies")
}

model Payment {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  licenseId String  @db.ObjectId
  license   License @relation(fields: [licenseId], references: [id])

  stripeSessionId String        @unique
  stripePaymentId String?
  amount          Float         @default(0)
  currency        String
  // productId       String
  status          PaymentStatus // 'paid', 'unpaid', 'cancelled', etc.
  createdAt       DateTime      @default(now())

  @@map("payments")
}

model Product {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  productPrice Float?
  productName  String? @unique
  productId    String? @unique
  licenseId    String? @unique
  priceId      String?

  @@map("product")
}
