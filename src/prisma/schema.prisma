generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}




model User {
  id                      String         @id @default(auto()) @map("_id") @db.ObjectId
  name                    String
  email                   String         @unique
  phone                   String
  password                String
  role                    userStatus
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  @@map("users")
}



model ContactUs {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String
  message       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("contactus")
}

enum userStatus{
  ADMIN
}


enum Status {
  PENDING
  COMPLETED
  CANCELLED
}

